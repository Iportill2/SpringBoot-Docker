MYSQL_DATABASE=aplicacion
MYSQL_USER=api_user
MYSQL_PASSWORD=pon_aqui_una_password_segura
MYSQL_ROOT_PASSWORD=pon_aqui_otra_password_segura_distinta
TZ=Europe/Madrid
COMPOSE_PROFILES=full
# Debe ser una cadena aleatoria de AL MENOS 32 bytes (por ej. 48 caracteres
# alfanumericos). Genera una con: openssl rand -base64 48
JWT_SECRET=pon_aqui_una_clave_secreta_aleatoria_de_al_menos_32_bytes
JWT_EXPIRATION_MS=14400000
BACKUP_SERVICE_USER=backup_service
BACKUP_SERVICE_PASSWORD=pon_aqui_una_password_segura_para_backup

# IP of this machine (active adapter: wifi or cable). Used by nginx (server_name)
# and to sign the SSL certificate. Get it with: ipconfig -> IPv4 Address
# (NOT the Default Gateway)
SERVER_IP=192.168.0.43
